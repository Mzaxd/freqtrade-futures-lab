{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "bot_name": "abn-sleeve-a-opt4",
  "dry_run": true,
  "dry_run_wallet": 4500,
  "cancel_open_orders_on_exit": false,
  "trading_mode": "futures",
  "margin_mode": "isolated",
  "max_open_trades": 4,
  "stake_currency": "USDT",
  "stake_amount": "unlimited",
  "tradable_balance_ratio": 0.99,
  "fiat_display_currency": "USD",
  "dataformat_ohlcv": "feather",
  "initial_state": "running",
  "unfilledtimeout": {
    "entry": 10,
    "exit": 10,
    "exit_timeout_count": 0,
    "unit": "minutes"
  },
  "entry_pricing": {
    "price_side": "other",
    "use_order_book": true,
    "order_book_top": 1,
    "price_last_balance": 0.0,
    "check_depth_of_market": {
      "enabled": false,
      "bids_to_ask_delta": 1
    }
  },
  "exit_pricing": {
    "price_side": "other",
    "use_order_book": true,
    "order_book_top": 1
  },
  "exchange": {
    "name": "binance",
    "key": "",
    "secret": "",
    "ccxt_config": {},
    "ccxt_async_config": {},
    "pair_whitelist": [
      "BTC/USDT:USDT",
      "ETH/USDT:USDT",
      "SOL/USDT:USDT",
      "BNB/USDT:USDT",
      "XRP/USDT:USDT",
      "ADA/USDT:USDT",
      "DOGE/USDT:USDT",
      "AVAX/USDT:USDT",
      "LINK/USDT:USDT",
      "DOT/USDT:USDT",
      "LTC/USDT:USDT",
      "UNI/USDT:USDT"
    ],
    "pair_blacklist": []
  },
  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],
  "internals": {
    "process_throttle_secs": 5
  },
  "strategy": "OPT4_VolatilitySystem",
  "strategy_path": "user_data/strategies/oss",
  "api_server": {
    "enabled": true,
    "listen_ip_address": "0.0.0.0",
    "listen_port": 8080,
    "username": "CHANGEME_USER",
    "password": "CHANGEME_PASSWORD",
    "jwt_secret_key": "CHANGEME_RANDOM_SECRET",
    "CORS_origins": [],
    "verbosity": "error"
  }
}